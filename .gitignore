# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# APK
*.apk

# Firebase configs
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
.worktrees/
.superpowers/
.icon_backup_20260624/

# Vendored packages: output of standalone IDE/Gradle imports.
# The app build itself writes plugin outputs to /build/.
packages/*/build/
packages/*/pubspec.lock
packages/*/android/.gradle/
packages/*/android/.kotlin/
packages/*/android/build/
packages/*/android/local.properties
packages/*/android/gradlew
packages/*/android/gradlew.bat
packages/*/android/gradle/wrapper/gradle-wrapper.jar
