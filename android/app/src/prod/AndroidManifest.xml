<!--
    TEST-flavor (legacy aeza bundle tirol.taler.taler_id_mobile) manifest
    overlay.

    Claims the deep-link host this build talks to, and only that one:
    id.taler.tirol. See src/main/AndroidManifest.xml for why the hosts are
    split per flavor rather than declared once for all three.

    The Android manifest merger will combine these <intent-filter>s with the
    filters already declared on MainActivity in src/main/AndroidManifest.xml.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <!-- https://id.taler.tirol/room/{code} -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="id.taler.tirol" android:pathPrefix="/room/"/>
            </intent-filter>
            <!-- https://id.taler.tirol/ui/invite.html -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="id.taler.tirol" android:pathPrefix="/ui/invite"/>
            </intent-filter>
            <!-- https://id.taler.tirol/oauth/auth — the OIDC authorization
                 endpoint, so a partner's "sign in with Taler ID" opens the app
                 instead of the browser. android:path, not pathPrefix:
                 /oauth/auth/{uid} is where the browser consent page continues,
                 and intercepting that would drag the user out of a flow they
                 started in the browser. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="id.taler.tirol" android:path="/oauth/auth"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
