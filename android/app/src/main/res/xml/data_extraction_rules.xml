<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing this app stores may leave the device through a backup or a
  device-to-device transfer: the app directory holds the mesh Ed25519/X25519
  private keys, the cached KYC record (document number, date and place of
  birth, address) and the profile cache.

  android:allowBackup="false" covers Android 11 and below; from Android 12
  these rules are what govern cloud backup and device transfer, and an app
  without them falls back to backing everything up.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
